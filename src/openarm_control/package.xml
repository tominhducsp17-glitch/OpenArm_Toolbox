<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openarm_control</name>
  <version>0.1.0</version>
  <description>OpenArm control library on the control-toolbox interface (no ROS node): Pinocchio dynamics as ct::core::ControlledSystem, tracking controllers as ct::core::Controller (CTC feedforward, gravity compensation).</description>
  <maintainer email="tominhducsp17@gmail.com">To Minh Duc</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ct_core</depend>
  <depend>pinocchio</depend>
  <depend>eigen</depend>
  <depend>boost</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_index_cpp</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
